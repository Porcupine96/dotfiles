#!/bin/bash

# Usage: lst [-a] [directory]
# Print the path to the most recently modified file in the directory (default: .).
# By default the path is relative to the current working directory, with -a it's absolute.

set -euo pipefail

absolute=false
if [[ "${1:-}" == "-a" ]]; then
  absolute=true
  shift
fi

dir="${1:-.}"

if [[ ! -d "$dir" ]]; then
  echo "lst: not a directory: $dir" >&2
  exit 1
fi

newest=$(find "$dir" -maxdepth 1 -type f -exec stat -f '%m %N' {} + | sort -rn | head -1 | cut -d' ' -f2-)

if [[ -z "$newest" ]]; then
  echo "lst: no files in $dir" >&2
  exit 1
fi

if $absolute; then
  realpath "$newest"
else
  echo "$newest"
fi
